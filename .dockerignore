# Dependencies — installed fresh inside the image
node_modules
npm-debug.log*

# Next.js build output — rebuilt inside the image
.next
out

# Local dev database — use a Docker volume instead
prisma/dev.db
prisma/dev.db-journal

# Prisma Windows binary — the image uses linux binary generated at build time
prisma/generated/query_engine-windows.dll.node
prisma/generated/query_engine-windows.dll.node.tmp*

# Environment — never bake secrets into the image
.env
.env.*

# Git / editor
.git
.gitignore
.vscode
*.md
